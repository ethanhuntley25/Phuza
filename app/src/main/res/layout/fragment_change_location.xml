<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/ui_background">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/title_current_location"
        android:textColor="@color/milk"
        android:textSize="24sp"
        android:gravity="center"
        android:fontFamily="@font/termina_test_black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingHorizontal="64dp"/>

    <FrameLayout
        android:id="@+id/search_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/search_background"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="24dp">

                <EditText
                    android:id="@+id/input_search_location"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:hint="@string/hint_enter_location"
                    android:fontFamily="@font/sora_regular"
                    android:textColorHint="@color/Dark_Purple"
                    android:textColor="@color/milk"
                    android:background="@android:color/transparent"
                    android:inputType="textPostalAddress"
                    android:imeOptions="actionSearch"
                    android:maxLines="1"
                    android:textSize="16sp"/>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_icon_search"
                    android:contentDescription="Search"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewSearchResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="4dp"
                android:paddingBottom="8dp"
                android:maxHeight="300dp"
                tools:itemCount="3"
                tools:listitem="@layout/item_location_search"/>
        </LinearLayout>
    </FrameLayout>

    <com.mapbox.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/search_container"
        app:layout_constraintBottom_toTopOf="@+id/selected_location_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_my_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_location"
        app:backgroundTint="@color/ui_background"
        app:layout_constraintBottom_toTopOf="@+id/selected_location_panel"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="Find current location"/>

    <LinearLayout
        android:id="@+id/selected_location_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:background="@color/ui_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selected Location:"
            android:textColor="@color/milk"
            android:fontFamily="@font/sora_regular"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tv_current_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/milk"
            android:textSize="18sp"
            android:fontFamily="@font/sora_semibold"
            android:layout_marginTop="4dp"
            tools:text="Cape Town City Centre"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>